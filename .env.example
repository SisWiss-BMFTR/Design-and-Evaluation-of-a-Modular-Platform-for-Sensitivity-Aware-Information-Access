# Copy this file to .env and fill in your real secrets.
OPENAI_API_KEY=...

# For a local OpenAI-compatible server such as vLLM serving Qwen3-32B:
# OPENAI_API_KEY=EMPTY
# OPENAI_BASE_URL=http://localhost:8000/v1
# GENERATION_MODEL=Qwen/Qwen3-32B
# QWEN_ENABLE_THINKING=false

# Independent guard switches for matched single-intervention experiments.
OUTPUT_LEAKAGE_VERIFIER_ENABLED=true
MEMBERSHIP_GUARD_ENABLED=true
EMBEDDING_PROBE_GUARD_ENABLED=true
PROMPT_INJECTION_GUARD_ENABLED=true
ACCESS_CHANGE_MEMORY_CLEAR_ENABLED=true
RELATION_ACCESS_GUARD_ENABLED=true

# Deprecated compatibility alias, used only when OUTPUT_LEAKAGE_VERIFIER_ENABLED
# is unset:
# POST_GENERATION_VERIFIER_ENABLED=true
